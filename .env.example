# MongoDB Atlas connection URI (Atlas cluster required for auto-embedding vector search)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-uri>/
# Optional overrides
DB_NAME=ecommerce_demo
PORT=3001
# Text field indexed by your Atlas Automated Embedding vector index (default: description)
VECTOR_PATH=description
